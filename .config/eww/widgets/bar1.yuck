(defwidget _clock1 []
  (eventbox :onhover "${EWW_CMD} update rev_clock_2=true" :onhoverlost "${EWW_CMD} update rev_clock_2=false" 
       :class "clock_btn" :tooltip " Clock"
    (box :orientation "h" :space-evenly false :class "clock_container"
      (label :text " ${time.hour}:${time.min} ")
      (revealer :transition "slideright" :reveal rev_clock_2 :duration "425ms"
        (label :text "| ${time.day}-${time.mouth}-${time.year} 󰸗 ")
      )
    )
  )
)

(defwidget bar1 []
  (centerbox :class "bar1" :orientation "h"
    (box :class "kb_btn" :tooltip "󱒃 Screen Sharing" :halign "start"
      (label :class "kb_txt" :text "Screen Sharing 󱒃")
    )
    (box :space-evenly false :halign "center"
      W(_workspaces)
    )
    (box :space-evenly false :halign "end" :spacing 5
      (_tray)
      (_clock1)
    )
  )
)