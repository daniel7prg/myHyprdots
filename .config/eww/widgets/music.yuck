;; Music
(defwidget music_info []
  (box :class "musicwin" :orientation "v" :space-evenly false :vexpand false :hexpand false
    (box :orientation "h" :space-evenly false :vexpand false :hexpand false :halign "fill"
      (box :orientation "h" :class "bx_player" :hexpand true :halign "start"
        (label :class "player" :text "${msc_info.player}")
      )
      (box :orientation "h" :class "bx_shifts" :visible "${msc_info.count >= 2 ? true : false}" :hexpand true :halign "start"
        (eventbox :width 15 :class "btn_unshift" :onclick "playerctld unshift" 
                  :cursor "pointer" :tooltip "Prev"
          (label :class "unshift" :text "")
        )
        (eventbox :width 15 :class "btn_shift" :onclick "playerctld shift" 
                  :cursor "pointer" :tooltip "Next"
          (label :class "shift" :text "")
        )
      )
    )
    (box :orientation "h" :space-evenly false :vexpand false :hexpand false :halign "fill"
      (overlay :vexpand true :hexpand true
        (box :orientation "h" :class "cava_module"
          (for bar in {cava_bar.bars}
            (box :class {
                  bar == 0 ? "cava_lvl_0" :
                  bar == 1 ? "cava_lvl_1" :
                  bar == 2 ? "cava_lvl_2" :
                  bar == 3 ? "cava_lvl_3" :
                  bar == 4 ? "cava_lvl_4" :
                  bar == 5 ? "cava_lvl_5" :
                  bar == 6 ? "cava_lvl_6" :
                  "cava_lvl_7"
                }
            )
          )
        )
        (box :orientation "v" :class "info_music"
          (label :class "song" :text "${msc_info.title}")
          (label :class "artist" :text "󰳩 ${msc_info.artist}")
        )
      )
      (button :class "album_art" :vexpand false :hexpand false :tooltip "${msc_info.title} - 󰳩 ${msc_info.artist}"
              :style "background-image: url('${msc_info.cover}');")
    )

    (box :orientation "v" :space-evenly true :vexpand false :hexpand false :class "info_song"
      (scale :class "scale_music" :min 0 :max {msc_info.scale} :value {msc_info.position}
             :active "${msc_info.artist == 'Offline' ? false : true}"
             :visible "${msc_info.minInit == '' && msc_info.artist != 'Offline' ? false : true}"
             :onchange "playerctl position {}")
      (box :orientation "h" :space-evenly true :vexpand false :hexpand false 
        (label :halign "start" :class "time_init" :text "${msc_info.artist == 'Offline' ? '' : msc_info.minInit}")
        (label :halign "end" :class "time_end" :text "${msc_info.artist == 'Offline' ? '' : msc_info.minEnd}")
      )
    )

    (box :orientation "h" :halign "center" :space-evenly true :vexpand false 
         :hexpand false :class "msc_ctl"
      (eventbox :class "btn_prev" :halign "start" :onclick "playerctl previous" :cursor "pointer"
        (label :class "prev" :text ""))
      (eventbox :class "btn_play" :halign "center" :onclick "playerctl play-pause" :cursor "pointer"
        (label :class "stat" :text {msc_info.status}))
      (eventbox :class "btn_next" :halign "end" :onclick "playerctl next" :cursor "pointer"
        (label :class "nxt" :text ""))
    )
  )
)

(defwidget music []
  (box :orientation "v" :space-evenly false :class "box_rev" 
    (revealer :transition "slidedown" :reveal open_music :duration "200ms"
      (music_info)
    )
  )
)