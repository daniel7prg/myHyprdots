;; MENU_OPT
(defwidget _menuIC []
  (eventbox :onclick "scripts/launch_menu&" :cursor "pointer" :tooltip " Menu"
            :class "${open_menu ? 'menu_btn_toggle' : 'menu_btn'}"
    (box :orientation "h" :space-evenly false :class "menu_container" :spacing 15
      (label :text "${volume.icon}")
      (label :text "${battery.icon}")
      (label :text "${bluetooth.icon}")
      (label :text "${network.icon}")
      (label :text "${open_menu ? '' : ''}")
    )
  )
)

(defwidget _clock []
  (eventbox :onhover "${EWW_CMD} update rev_clock=true" :onhoverlost "${EWW_CMD} update rev_clock=false" 
            :onclick "scripts/launch_cal&" :class "${open_cal ? 'clock_btn_toggle' : 'clock_btn'}"
            :tooltip " Clock" :cursor "pointer"
    (box :orientation "h" :space-evenly false :class "clock_container"
      (label :text " ${time.hour}:${time.min} ")
      (revealer :transition "slideright" :reveal rev_clock :duration "425ms"
        (label :text "| ${time.day}-${time.mouth}-${time.year} 󰸗 ")
      )
    )
  )
)

(defwidget _music []
  (eventbox :cursor "pointer" :onclick "scripts/launch_music&" :class "${open_music ? 'music_btn_toggle' : 'music_btn'}"
            :tooltip "󰽴 Music Player"
    (box :orientation "h" :space-evenly false :class "music_container" :spacing 5
      (overlay :vexpand false :hexpand true
        (label :text "${msc_info.icon}" :class "music_icon")
        (circular-progress :value {msc_info.circular} :class "music_prg" :thickness 2)
      )
      (label :text "|")
      (label :text "${msc_info.title}" :limit-width 15)
    )
  )
)


(defwidget _wallpaper []
  (eventbox :onhover "${EWW_CMD} update rev_wal=true" :onhoverlost "${EWW_CMD} update rev_wal=false" 
            :onclick "pkill -x yad || scripts/choosewall&" :class "wallpaper_btn"
            :tooltip "󰸉 Change Wal" :cursor "pointer"
    (box :orientation "h" :space-evenly false :class "wal_container"
      (label :text "󰋯" :width 30)
      (revealer :transition "slideright" :reveal rev_wal :duration "350ms"
        (label :class "wal_txt" :text "Wal")
      )
    )
  )
)

(defwidget _keyboard []
  (eventbox :onclick "hyprctl -q switchxkblayout current next" :class "kb_btn" 
            :tooltip "${active_keymap.layEx}" :cursor "pointer"
    (label :class "kb_txt" :text "${active_keymap.lay}")
  )
)

(defwidget _appnames []
  (box :orientation "h" :halign "center" :space-evenly false :spacing 8 :class "app_box"
    (box :class "app_img" :vexpand false :valign "center" :hexpand false 
         :style "background-image: url('${appname.icon}')") 
    (label :text "${appname.title}" :tooltip " ${appname.title}" :limit-width 35)
  )
)

(defwidget _apps []
  (eventbox :onhover "${EWW_CMD} update rev_apps=true" :onhoverlost "${EWW_CMD} update rev_apps=false"
            :onclick "pkill -x rofi || sh -c '(sleep 0.15s; ${open_apps})' & disown" :class "apps_btn"
            :tooltip " App Menu" :cursor "pointer"
    (box :orientation "h" :space-evenly false :class "app_container"
      (label :text "" :width 25)
      (revealer :transition "slideright" :reveal rev_apps :duration "350ms"
        (label :class "app_txt" :text "Apps")
      )
    )
  )
)

(defwidget _tray []
  (eventbox :onclick "${rev_tray ? 'eww update rev_tray=false' : 'eww update rev_tray=true'}"
            :cursor "pointer" :hexpand true :tooltip "󱊖 App center" 
    (box :orientation "h" :space-evenly false :spacing 3 :class "tray_box"
      (label :text "${rev_tray ? '' : ''}" :width 25)
      (revealer :transition "slideright" :reveal rev_tray :duration "350ms"
        (systray :icon-size 25 :prepend-new true :spacing 5 :orientation "h" :class "tray_container")
      )
    )
  )
)

(defwidget _workspaces []
  (eventbox :class "workspaces" :cursor "pointer"
            :onscroll "echo {} | sed -e \"s/up/-1/g\" -e \"s/down/+1/g\" | xargs hyprctl dispatch workspace"
    (box :orientation "h" :space-evenly false :spacing 5 :class "wks_container"
      (for ws in my-workspaces
        (button :onclick "hyprctl dispatch workspace ${ws}"
          :class {
              workspaces.total[ws - 1] == 1 ? "active_wk_btn" :
              workspaces.total[ws - 1] == 2 ? "used_wk_btn" :
              "empty_wk_btn"
          }
          (label
            :tooltip {
              workspaces.total[ws - 1] == 1 ? "Active" :
              workspaces.total[ws - 1] == 2 ? "Used" :
              "Empty"
            }
            :text {
              workspaces.total[ws - 1] == 1 ? "󰮯" :
              workspaces.total[ws - 1] == 2 ? "" :
              "󱙝"
            }
          )
        )
      )
    )
  )
)

(defwidget _workspaces_dyn []
  (eventbox :class "workspaces" :cursor "pointer"
            :onscroll "echo {} | sed -e \"s/up/-1/g\" -e \"s/down/+1/g\" | xargs hyprctl dispatch workspace"
    (box :orientation "h" :space-evenly false :spacing 5 :class "wks_container"
      (for ws in {workspaces.active}
        (button :onclick "hyprctl dispatch workspace ${ws}"
          :class "${ws == workspaces.current ? 'active_wk_btn_dyn' : 'used_wk_btn_dyn'}"
          :tooltip "${ws == workspaces.current ? 'Active' : 'Used'}"
          "${ws}"
        )
      )
    )
  )
)

(defwidget bar []
  (centerbox :class "bar" :orientation "h"
    (box :space-evenly false :halign "start" :spacing 5
      (_apps)
      (_wallpaper)
      (_keyboard)
      (_workspaces_dyn) 
    )
    (box :space-evenly false :halign "center"
      (_appnames)
    )
    (box :space-evenly false :halign "end" :spacing 5
      (_tray)
      (_music)
      (_clock)
      (_menuIC)
    )
  )
)
