(defwindow power
    :stacking "fg"
    :monitor 0
    :namespace "power_layer"
	:geometry (geometry
        :x "0%" 
	    :y "30%"
        :anchor "top right")
    (power)
)

(defwindow reboot
    :stacking "fg"
    :monitor 0
    :namespace "power_layer"
	:geometry (geometry
        :x "0%" 
	    :y "35%"
        :anchor "top right")
    (reboot)
)

