#!/bin/bash

# __________________________
# | Select cursor/icon theme |
# --------------------------

notify-send -a "Setting Theme " "Getting your config" -t 2500
sleep 3s

# Function to get current configuration values ​​(more robust)
get_config_value() {
    # Find the line starting with the key and extract the value after the '='
    grep "^$1=" "$2" | cut -d "=" -f 2 | sed "s/'//g"
}

# Function to apply changes to configuration files
update_config_file() {
    local config_file="$1"
    local key="$2"
    local value="$3"
    # Escape slashes for sed if the value can contain them
    local escaped_value=$(printf '%s\n' "$value" | sed -e 's/[\/&]/\\&/g')
    sed -i "s/^$key=.*/$key=$escaped_value/" "$config_file"
}

# Current values
current_theme=$(get_config_value "gtk-application-prefer-dark-theme" ~/.config/gtk-3.0/settings.ini)
currentIconD=$(get_config_value "iconDark" ~/.config/rofi/scripts/globalcontrol.sh)
currentIconL=$(get_config_value "iconLight" ~/.config/rofi/scripts/globalcontrol.sh)
currentCursorT=$(get_config_value "gtk-cursor-theme-name" ~/.config/gtk-3.0/settings.ini)
currentCursorS=$(get_config_value "gtk-cursor-theme-size" ~/.config/gtk-3.0/settings.ini)

# List icons and cursors themes
iconTheme=$(find /usr/share/icons -type f -name "index.theme" \
            -exec grep -l -i "director*" {} \; | grep -v "/hicolor/" | awk -F'/' '{print $(NF-1)}' | sort -u)
cursorTheme=$(find /usr/share/icons \( -type d -o -type l \) -name "cursors" | awk -F'/' '{print $(NF-1)}' | sort -u)

# Sort list by current values
sort_list() {
    local list="$1"
    local current_val="$2"
    echo "$list" | grep "^$current_val$"
    echo "$list" | grep -v "^$current_val$"
}

# Prepare list for YAD
sortedIconThemeD=$(sort_list "$iconTheme" "$currentIconD" | tr '\n' '!')
sortedIconThemeL=$(sort_list "$iconTheme" "$currentIconL" | tr '\n' '!')
sortedCursorTheme=$(sort_list "$cursorTheme" "$currentCursorT" | tr '\n' '!')
cursorSize=$(printf "16\n20\n22\n24\n28\n32\n40\n48\n56\n64\n72\n80\n88\n96")
sortedCursorSize=$(sort_list "$cursorSize" "$currentCursorS" | tr '\n' '!')

# Show options with YAD
options=$(yad --title="Theme Settings" --text-align=center --text="<b>THEME SETTINGS 󰉦</b>" --form \
    --field="Icon Dark Theme ::CB" "$sortedIconThemeD" \
    --field="Icon Light Theme ::CB" "$sortedIconThemeL" \
    --field="Cursor Theme ::CB" "$sortedCursorTheme" \
    --field="Cursor Size ::CB" "$sortedCursorSize")

# Exit if user cancels YAD
[[ -z $options ]] && exit 0

# Extrat selected options
IFS="|" read -r iconDark iconLight cursorT cursorS <<< "$options"

# --- Theme Application ---

# Function to apply icon theme (unified)
apply_icon_theme() {
    local selected_icon_theme="$1"
    local theme_type_desc="$2" # Ex: "Dark Theme" or "Light Theme"
    local config_var="$3"      # Ex: iconDark or iconLight for globalcontrol.sh

    # Ask for confirmation
    yad --image="dialog-question" --title "Alert" --text "Apply $theme_type_desc ?" --button="yad-cancel:1" --button="yad-ok:0" || return 1
    killall dunst
    sed -i "s/icon_theme = .*/icon_theme = \"${selected_icon_theme}\"/" ~/.config/dunst/dunstrc
    update_config_file ~/.config/gtk-3.0/settings.ini "gtk-icon-theme-name" "$selected_icon_theme"
    gsettings set org.gnome.desktop.interface icon-theme "'$selected_icon_theme'"
    update_config_file ~/.config/rofi/scripts/globalcontrol.sh "$config_var" "'$selected_icon_theme'"
    update_config_file ~/.config/qt5ct/qt5ct.conf "icon_theme" "$selected_icon_theme"
    update_config_file ~/.config/qt6ct/qt6ct.conf "icon_theme" "$selected_icon_theme"
    eww reload
    notify-send -a "Icon Theme " "Apply $theme_type_desc" "$selected_icon_theme"
    return 0
}

# Apply Light Theme
if [[ "$currentIconL" != "$iconLight" && "$current_theme" -eq 0 ]]; then
    apply_icon_theme "$iconLight" "Light Theme" "iconLight"
fi

# Apply Dark Theme
if [[ "$currentIconD" != "$iconDark" && "$current_theme" -eq 1 ]]; then
    apply_icon_theme "$iconDark" "Dark Theme" "iconDark"
fi

# Apply Cursor Theme
if [[ "$currentCursorT" != "$cursorT" ]]; then
    yad --image="dialog-question" --title "Alert" --text "Apply cursor theme ?" --button="yad-cancel:1" --button="yad-ok:0" || exit 0
    gsettings set org.gnome.desktop.interface cursor-theme "'$cursorT'"
    update_config_file ~/.config/gtk-3.0/settings.ini "gtk-cursor-theme-name" "$cursorT"
    # update_config_file ~/.local/share/icons/default/index.theme "Inherits" "$cursorT" # Uncomment if the cursor theme is not found globally
    pkexec sed -i "s/Inherits=.*/Inherits=$cursorT/" /usr/share/icons/default/index.theme
    notify-send -a "Cursor Theme " "DONE" "Reboot or logout to apply cursor theme changes"
fi

# Apply Cursor Size
if [[ "$currentCursorS" != "$cursorS" ]]; then
    yad --image="dialog-question" --title "Alert" --text "Apply cursor size 󰆿?" --button="yad-cancel:1" --button="yad-ok:0" || exit 0
    gsettings set org.gnome.desktop.interface cursor-size $cursorS
    update_config_file ~/.config/gtk-3.0/settings.ini "gtk-cursor-theme-size" "$cursorS"
    sed -i -e "s/env = XCURSOR_SIZE,.*/env = XCURSOR_SIZE,$cursorS/" -e "s/env = HYPRCURSOR_SIZE,.*/env = HYPRCURSOR_SIZE,$cursorS/" ~/.config/hypr/conf/env.conf
    pkexec sed -i "s/CursorSize=.*/CursorSize=$cursorS/" /etc/sddm.conf
    notify-send -a "Cursor Theme " "DONE" "Reboot or logout to apply cursor size changes"
fi