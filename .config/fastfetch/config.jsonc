{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
	    "source": "~/.config/fastfetch/hyprland.txt",
	    "padding": {
		    "top": 1,
            "left": 0,
            "right": 1
	    }
    },
    "display": {
        "separator": ": "
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "├─────────────────── {#36}System Info  {#37}───────────────────┤",
        },
        "break",
        {
            "type": "title",
            "format": "\t {6}{7}{8}  ",
        },
        {
            "type": "os",
            "key": "\t󰌽 OS",
            "format": "{2}",
            "keyColor": "31",
        },
        {
            "type": "kernel",
            "key": "\t Kernel",
            "format": "{2}",
            "keyColor": "32",
        },
        {
            "type": "packages",
            "key": "\t󰏗 Packages",
            "format": "{2} (pacman)",
            "keyColor": "33",
        },
        {
            "type": "shell",
            "key": "\t󰆍 Shell",
            "format": "{3} {4}",
            "keyColor": "34",
        },
        {
            "type": "terminal",
            "key": "\t Terminal",
            "format": "{3} {6}",
            "keyColor": "35",
        },
        {
            "type": "wm",
            "key": "\t󱂬 WM",
            "format": "{1} ({3})",
            "keyColor": "36",
        },
        {
            "type": "uptime",
            "key": "\t󰥔 Uptime",
            "format": "{2}h {3}m {4}s",
            "keyColor": "default"
        },
        {
            "type": "cpu",
            "key": "\t CPU",
            "format": "{1} ({5}) @ {7}",
            "keyColor": "31",
        },
        {
            "type": "gpu",
            "key": "\t󰢮 GPU",
            "format": "{2}",
            "keyColor": "32",        
        },
        {
            "type": "memory",
            "key": "\t Memory",
            "format": "{1} / {2} ({3})",
            "keyColor": "33",
        },
        {
            "type": "colors",
            "key": "\t Colors",
            "symbol": "circle",
            "keyColor": "34",
        },
        "break",
        {
            "type": "custom",
            "format": "├─────────────────────────────────────────────────────┤",
        },
        "break"
    ]
}
